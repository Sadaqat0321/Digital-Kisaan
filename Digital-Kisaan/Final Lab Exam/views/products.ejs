<style>
    .catalog-container {
        display: flex;
        gap: 30px;
        margin: 40px auto;
        max-width: 1200px;
        padding: 0 20px;
    }

    .filters-sidebar {
        flex: 0 0 280px;
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        align-self: start;
        position: sticky;
        top: 20px;
    }

    .filters-sidebar h3 {
        margin-bottom: 20px;
        font-size: 1.2rem;
        color: #333;
        border-bottom: 2px solid #28a745;
        padding-bottom: 10px;
        display: inline-block;
    }

    .filter-group {
        margin-bottom: 20px;
    }

    .filter-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #555;
        font-size: 0.95rem;
    }

    .filter-group input, .filter-group select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s;
    }

    .filter-group input:focus, .filter-group select:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .price-inputs {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .price-inputs span {
        color: #777;
    }

    .btn-filter {
        width: 100%;
        padding: 12px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
        margin-top: 10px;
    }

    .btn-filter:hover {
        background: #218838;
    }

    .catalog-main {
        flex: 1;
    }

    .catalog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        background: #fff;
        padding: 15px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    /* Pagination Styles */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
    }

    .pagination-btn {
        padding: 10px 16px;
        border: 1px solid #ddd;
        border-radius: 6px;
        background: #fff;
        color: #333;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

    .pagination-btn:hover {
        background: #f1f1f1;
    }

    .pagination-btn.active {
        background: #28a745;
        color: white;
        border-color: #28a745;
    }

    .pagination-btn.disabled {
        color: #aaa;
        pointer-events: none;
        background: #f9f9f9;
    }

    /* Responsive adjustments */
    @media (max-width: 900px) {
        .catalog-container {
            flex-direction: column;
        }
        .filters-sidebar {
            flex: none;
            width: 100%;
            position: static;
        }
    }
    
    .no-results {
        text-align: center;
        padding: 50px 20px;
        background: #fff;
        border-radius: 12px;
        color: #666;
        font-size: 1.1rem;
    }
</style>

<div class="catalog-container">
    <!-- Sidebar Filters -->
    <aside class="filters-sidebar">
        <h3>Filter Products</h3>
        <form action="/products" method="GET">
            <div class="filter-group">
                <label>Search Name</label>
                <input type="text" name="search" value="<%= search %>" placeholder="E.g. Wheat...">
            </div>

            <div class="filter-group">
                <label>Category</label>
                <select name="category">
                    <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
                    <option value="Seeds" <%= category === 'Seeds' ? 'selected' : '' %>>Seeds</option>
                    <option value="Fertilizer" <%= category === 'Fertilizer' ? 'selected' : '' %>>Fertilizer</option>
                    <option value="Tools" <%= category === 'Tools' ? 'selected' : '' %>>Tools</option>
                    <option value="Crops" <%= category === 'Crops' ? 'selected' : '' %>>Crops</option>
                    <option value="Machinery" <%= category === 'Machinery' ? 'selected' : '' %>>Machinery</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Price Range (Rs)</label>
                <div class="price-inputs">
                    <input type="number" name="minPrice" placeholder="Min" value="<%= minPrice %>" min="0">
                    <span>-</span>
                    <input type="number" name="maxPrice" placeholder="Max" value="<%= maxPrice %>" min="0">
                </div>
            </div>

            <button type="submit" class="btn-filter">Apply Filters</button>
            <a href="/products" class="btn btn-outline full-width" style="margin-top: 10px; display: block; text-align: center;">Reset</a>
        </form>
    </aside>

    <!-- Main Product Area -->
    <main class="catalog-main">
        <div class="catalog-header">
            <h2>Our Products</h2>
            <div class="results-count">
                Showing Page <%= currentPage %> of <%= totalPages || 1 %>
            </div>
        </div>

        <% if (products.length === 0) { %>
            <div class="no-results">
                <i class="fa-solid fa-box-open" style="font-size: 3rem; color: #ddd; margin-bottom: 20px;"></i>
                <h2>No Products Found</h2>
                <p>Try adjusting your search or filters to find what you're looking for.</p>
            </div>
        <% } else { %>
            <div class="products-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <div class="product-img">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <% if (product.badge) { %>
                                <span class="badge <%= product.badge.toLowerCase() === 'sale' ? 'sale' : '' %>"><%= product.badge %></span>
                            <% } %>
                            <% if (product.isOnSale) { %>
                                <span class="badge sale" style="top:auto; bottom:10px;">ON SALE</span>
                            <% } %>
                        </div>
                        <div class="product-info">
                            <span class="category"><%= product.category %></span>
                            <h3><%= product.name %></h3>
                            <div class="price">
                                ₨ <%= product.price.toLocaleString() %>
                                <% if (product.oldPrice) { %>
                                    <span class="old-price">₨ <%= product.oldPrice.toLocaleString() %></span>
                                <% } %>
                            </div>
                            <div class="rating">
                                <i class="fa-solid fa-star"></i> <%= product.rating %> (<%= product.stock %> in stock)
                            </div>
                            <button class="btn btn-outline full-width">Add to Cart</button>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Pagination Controls -->
            <% if (totalPages > 1) { %>
                <div class="pagination-container">
                    <!-- Previous Button -->
                    <a href="/products?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>" 
                       class="pagination-btn <%= currentPage === 1 ? 'disabled' : '' %>">
                       <i class="fa-solid fa-chevron-left"></i> Previous
                    </a>

                    <!-- Page Numbers -->
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/products?page=<%= i %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>" 
                           class="pagination-btn <%= currentPage === i ? 'active' : '' %>">
                           <%= i %>
                        </a>
                    <% } %>

                    <!-- Next Button -->
                    <a href="/products?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>" 
                       class="pagination-btn <%= currentPage === totalPages ? 'disabled' : '' %>">
                       Next <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </div>
            <% } %>
        <% } %>
    </main>
</div>
